# Copia este archivo como .env para trabajar en local:  cp .env.ejemplo .env
# En Docker Compose estos mismos valores vienen de docker-compose.yml, no de este archivo.

# --- Identificacion del servicio (asi se presenta en X-Servicio-Origen) ---
NOMBRE_SERVICIO=ventas
PUERTO=8000

# --- Base de datos propia (RNF02: ningun otro servicio entra aqui) ---
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=ventas_db
DB_USUARIO=ventas
DB_CLAVE=ventas
CREAR_TABLAS=true

# --- Otros servicios ---
INVENTARIO_URL=http://localhost:8001
BALANCE_URL=http://localhost:8005
TIMEOUT_SEGUNDOS=3
MAX_INTENTOS=3

# --- Inventario simulado (mientras el servicio real no este listo) ---
USAR_MOCK_INVENTARIO=true
MOCK_PRECIO=10000
MOCK_STOCK_DISPONIBLE=100
