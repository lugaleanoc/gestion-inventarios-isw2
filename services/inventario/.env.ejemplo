# Copia este archivo como .env para trabajar en local:  cp .env.ejemplo .env
# En Kubernetes estos mismos valores vienen del ConfigMap y del Secret, no de este archivo.

# --- Identificacion del servicio ---
NOMBRE_SERVICIO=inventario
PUERTO=8000

# --- Base de datos propia (RNF02: ningun otro servicio entra aqui) ---
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=inventario_db
DB_USUARIO=inventario
DB_CLAVE=inventario
# Crea las tablas al arrancar si no existen. En produccion se pone en false.
CREAR_TABLAS=true

# --- URLs de los servicios a los que llamamos (RNF17: todo por REST) ---
CONFIGURACION_URL=http://configuracion-service:8000
PROVEEDORES_URL=http://proveedores-service:8000
REPOSICION_URL=http://reposicion-service:8000

# --- Politica de llamadas entre servicios (RF30) ---
TIMEOUT_SEGUNDOS=3
MAX_REINTENTOS=3
# Numero de fallos seguidos tras los cuales el circuit breaker deja de intentar
CB_FALLOS_PARA_ABRIR=5
# Segundos que el circuito permanece abierto antes de volver a probar
CB_SEGUNDOS_ABIERTO=30

# --- Valor por defecto mientras el servicio de Configuracion no este listo ---
# Permite trabajar sin depender de Jasmin. Cuando Configuracion exista, se ignora.
STOCK_MINIMO_POR_DEFECTO=5
