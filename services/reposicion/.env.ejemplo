# Copia este archivo como .env para trabajar en local: cp .env.ejemplo .env

NOMBRE_SERVICIO=reposicion
PUERTO=8000

# Base de datos propia (RNF02)
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=reposicion_db
DB_USUARIO=reposicion
DB_CLAVE=reposicion
CREAR_TABLAS=true

# Servicios a los que llama (RNF17: todo por REST)
INVENTARIO_URL=http://inventario-service:8000
PROVEEDORES_URL=http://proveedores-service:8000
CONFIGURACION_URL=http://configuracion-service:8000

# Politica de llamadas entre servicios (RF30)
TIMEOUT_SEGUNDOS=3
MAX_REINTENTOS=3
CB_FALLOS_PARA_ABRIR=5
CB_SEGUNDOS_ABIERTO=30

# Valores por defecto mientras Configuracion no exista
STOCK_MINIMO_POR_DEFECTO=5
FACTOR_REPOSICION=3
