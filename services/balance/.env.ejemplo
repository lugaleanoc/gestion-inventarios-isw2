# Copia este archivo como .env para trabajar en local:  cp .env.ejemplo .env
# En Docker Compose estos mismos valores vienen de docker-compose.yml, no de este archivo.

# --- Identificacion del servicio ---
NOMBRE_SERVICIO=balance-diario
PUERTO=8000

# --- Base de datos propia (RNF02: ningun otro servicio entra aqui) ---
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=balance_db
DB_USUARIO=balance
DB_CLAVE=balance
# Crea las tablas al arrancar si no existen. En produccion se pone en false.
CREAR_TABLAS=true

